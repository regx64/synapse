+
+/**
+ * Synapse: language packs built into the app (`synapse-languagepacks.json`
+ * next to `nls.messages.json`, written at build time). Translation paths in
+ * the file are relative to that folder.
+ */
+export async function getBuiltinLanguagePacks(nlsMetadataPath: string): Promise<ILanguagePacks | undefined> {
+	try {
+		const packs: ILanguagePacks = JSON.parse(await promises.readFile(join(nlsMetadataPath, 'synapse-languagepacks.json'), 'utf-8'));
+		const result: ILanguagePacks = {};
+		for (const [language, pack] of Object.entries(packs)) {
+			if (!pack) {
+				continue;
+			}
+			const translations: Record<string, string | undefined> = {};
+			for (const [id, path] of Object.entries(pack.translations)) {
+				translations[id] = path ? join(nlsMetadataPath, path) : undefined;
+			}
+			result[language] = { ...pack, translations };
+		}
+		return result;
+	} catch (err) {
+		return undefined;
 	}
 }
 

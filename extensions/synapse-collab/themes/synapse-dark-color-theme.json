  "synapse.statusIdle": "#A1A1AA"
 },
 "semanticTokenColors": {
  "parameter": "#D4D4D8",
  "property": "#C8C8CC",
  "enumMember": "#E5C07B",
  "*.defaultLibrary": {
   "foreground": "#9CC4E4"
  },
  "variable.readonly": "#E5C07B"
 },
 "tokenColors": [
  {
   "name": "Comments",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#80808A",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Keywords",
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "keyword.operator.new",
    "keyword.operator.expression",
    "keyword.operator.logical.python"
   ],
   "settings": {
    "foreground": "#B4A7D6"
   }
  },
  {
   "name": "Operators",
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#A1A1AA"
   }
  },
  {
   "name": "Strings",
   "scope": [
    "string",
    "string.template",
    "punctuation.definition.string"
   ],
   "settings": {
    "foreground": "#A8D5BA"
   }
  },
  {
   "name": "Escapes, regex",
   "scope": [
    "constant.character.escape",
    "string.regexp"
   ],
   "settings": {
    "foreground": "#86EBD0"
   }
  },
  {
   "name": "Numbers and constants",
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.other",
    "support.constant",
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#E5C07B"
   }
  },
  {
   "name": "Functions",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function",
    "variable.function"
   ],
   "settings": {
    "foreground": "#EDEDEF"
   }
  },
  {
   "name": "Types",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "entity.name.namespace",
    "support.type",
    "support.class",
    "entity.other.inherited-class",
    "storage.type.primitive",
    "meta.type.annotation entity.name.type"
   ],
   "settings": {
    "foreground": "#9CC4E4"
   }
  },
  {
   "name": "Variables",
   "scope": [
    "variable",
    "variable.parameter",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#D4D4D8"
   }
  },
  {
   "name": "Properties",
   "scope": [
    "variable.other.property",
    "variable.other.object.property",
    "support.variable.property",
    "meta.object-literal.key",
    "entity.name.tag.yaml",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#C8C8CC"
   }
  },
  {
   "name": "this, self",
   "scope": [
    "variable.language"
   ],
   "settings": {
    "foreground": "#B4A7D6",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Tags",
   "scope": [
    "entity.name.tag",
    "punctuation.definition.tag"
   ],
   "settings": {
    "foreground": "#9CC4E4"
   }
  },
  {
   "name": "Attributes",
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#B4A7D6"
   }
  },
  {
   "name": "Decorators",
   "scope": [
    "meta.decorator",
    "entity.name.function.decorator",
    "punctuation.decorator"
   ],
   "settings": {
    "foreground": "#E5C07B"
   }
  },
  {
   "name": "Markdown headings",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#FAFAFA",
    "fontStyle": "bold"
   }
  },
  {
   "name": "Markdown",
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "fontStyle": "bold"
   }
  },
  {
   "name": "Markdown italic",
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "fontStyle": "italic"
   }
  },
  {
   "name": "Markdown code",
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ],
   "settings": {
    "foreground": "#A8D5BA"
   }
  },
  {
   "name": "Markdown links",
   "scope": [
    "markup.underline.link",
    "string.other.link"
   ],
   "settings": {
    "foreground": "#9CC4E4"
   }
  },
  {
   "name": "Diff inserted",
   "scope": [
    "markup.inserted"
   ],
   "settings": {
    "foreground": "#6EE7A0"
   }
  },
  {
   "name": "Diff deleted",
   "scope": [
    "markup.deleted"
   ],
   "settings": {
    "foreground": "#F87171"
   }
  },
  {
   "name": "Diff changed",
   "scope": [
    "markup.changed"
   ],
   "settings": {
    "foreground": "#D9C38A"
   }
  },
  {
   "name": "Invalid",
   "scope": [
    "invalid"
   ],
   "settings": {
    "foreground": "#F87171"
   }
  }
 ]
}
{
  "name": "synapse-collab",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "synapse",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "synapse",
          "title": "%container.agents%",
          "icon": "media/synapse.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "synapse-detail",
          "title": "%container.detail%",
          "icon": "media/synapse.svg"
        }
      ]
    },
    "views": {
      "synapse": [
        {
          "type": "webview",
          "id": "synapse.agents",
          "name": "%view.agents%"
        }
      ],
      "synapse-detail": [
        {
          "type": "webview",
          "id": "synapse.detail",
          "name": "%view.detail%"
        }
      ]
    },
    "commands": [
      {
        "command": "synapse.startCore",
        "title": "%cmd.startCore%",
        "category": "Synapse"
      },
      {
        "command": "synapse.stopCore",
        "title": "%cmd.stopCore%",
        "category": "Synapse"
      },
      {
        "command": "synapse.addAgent",
        "title": "%cmd.addAgent%",
        "category": "Synapse",
        "icon": "$(add)"
      },
      {
        "command": "synapse.startAgent",
        "title": "%cmd.startAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.stopAgent",
        "title": "%cmd.stopAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.restartAgent",
        "title": "%cmd.restartAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.removeAgent",
        "title": "%cmd.removeAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.promptAgent",
        "title": "%cmd.promptAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.cancelAgent",
        "title": "%cmd.cancelAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.teamAdopt",
        "title": "%cmd.teamAdopt%",
        "category": "Synapse"
      },
      {
        "command": "synapse.liveDiff",
        "title": "%cmd.liveDiff%",
        "category": "Synapse"
      },
      {
        "command": "synapse.steerAgent",
        "title": "%cmd.steerAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.takeover",
        "title": "%cmd.takeover%",
        "category": "Synapse"
      },
      {
        "command": "synapse.openWorktree",
        "title": "%cmd.openWorktree%",
        "category": "Synapse"
      },
      {
        "command": "synapse.checkConflicts",
        "title": "%cmd.checkConflicts%",
        "category": "Synapse",
        "icon": "$(refresh)"
      },
      {
        "command": "synapse.prepareReview",
        "title": "%cmd.prepareReview%",
        "category": "Synapse",
        "icon": "$(git-merge)"
      },
      {
        "command": "synapse.showOutput",
        "title": "%cmd.showOutput%",
        "category": "Synapse"
      },
      {
        "command": "synapse.resetAgent",
        "title": "%cmd.resetAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.agentMenu",
        "title": "%cmd.agentMenu%",
        "category": "Synapse"
      },
      {
        "command": "synapse.editPolicy",
        "title": "%cmd.editPolicy%",
        "category": "Synapse"
      },
      {
        "command": "synapse.newTask",
        "title": "%cmd.newTask%",
        "category": "Synapse"
      },
      {
        "command": "synapse.initConfig",
        "title": "%cmd.initConfig%",
        "category": "Synapse"
      },
      {
        "command": "synapse.pinDecision",
        "title": "%cmd.pinDecision%",
        "category": "Synapse"
      },
      {
        "command": "synapse.openHome",
        "title": "%cmd.openHome%",
        "category": "Synapse",
        "icon": "$(home)"
      },
      {
        "command": "synapse.showFiles",
        "title": "%cmd.showFiles%",
        "category": "Synapse",
        "icon": "$(files)"
      },
      {
        "command": "synapse.showAgents",
        "title": "%cmd.showAgents%",
        "category": "Synapse",
        "icon": "$(organization)"
      },
      {
        "command": "synapse.showDetail",
        "title": "%cmd.showDetail%",
        "category": "Synapse"
      },
      {
        "command": "synapse.enableTeam",
        "title": "%cmd.enableTeam%",
        "category": "Synapse"
      },
      {
        "command": "synapse.selectAgent",
        "title": "%cmd.selectAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.nextAgent",
        "title": "%cmd.nextAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.previousAgent",
        "title": "%cmd.previousAgent%",
        "category": "Synapse"
      },
      {
        "command": "synapse.focusGuidance",
        "title": "%cmd.focusGuidance%",
        "category": "Synapse"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "synapse.addAgent",
          "when": "view == synapse.agents",
          "group": "navigation@1"
        },
        {
          "command": "synapse.openHome",
          "when": "view == synapse.agents",
          "group": "navigation@2"
        },
        {
          "command": "synapse.checkConflicts",
          "when": "view == synapse.agents",
          "group": "navigation@3"
        },
        {
          "command": "synapse.prepareReview",
          "when": "view == synapse.agents",
          "group": "navigation@4"
        },
        {
          "command": "synapse.showAgents",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "synapse.pinDecision",
          "when": "resourceScheme == file",
          "group": "synapse@1"
        }
      ],
      "commandPalette": [
        {
          "command": "synapse.agentMenu",
          "when": "false"
        },
        {
          "command": "synapse.teamAdopt",
          "when": "false"
        },
        {
          "command": "synapse.pinDecision",
          "when": "editorIsOpen"
        },
        {
          "command": "synapse.showDetail",
          "when": "false"
        },
        {
          "command": "synapse.selectAgent",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Synapse",
      "properties": {
        "synapse.autoStartCore": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoStartCore%"
        },
        "synapse.corePath": {
          "type": "string",
          "default": "",
          "description": "%config.corePath%"
        },
        "synapse.nodePath": {
          "type": "string",
          "default": "",
          "description": "%config.nodePath%"
        },
        "synapse.showInlineOwners": {
          "type": "boolean",
          "default": true,
          "description": "%config.showInlineOwners%"
        },
        "synapse.showWalkthroughOnStart": {
          "type": "boolean",
          "default": false,
          "description": "%config.showWalkthroughOnStart%"
        },
        "synapse.openHomeOnStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.openHomeOnStart%"
        },
        "synapse.notifications.approvals": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications.approvals%"
        },
        "synapse.notifications.errors": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications.errors%"
        },
        "synapse.notifications.finished": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications.finished%"
        },
        "synapse.workbenchFont": {
          "type": "boolean",
          "default": true,
          "description": "%config.workbenchFont%"
        },
        "synapse.autoHideAgentColumn": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoHideAgentColumn%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "synapse.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "config",
            "title": "%walkthrough.config.title%",
            "description": "%walkthrough.config.description%",
            "media": {
              "markdown": "media/walkthrough/config.md"
            }
          },
          {
            "id": "agents",
            "title": "%walkthrough.agents.title%",
            "description": "%walkthrough.agents.description%",
            "media": {
              "markdown": "media/walkthrough/agents.md"
            }
          },
          {
            "id": "tasks",
            "title": "%walkthrough.tasks.title%",
            "description": "%walkthrough.tasks.description%",
            "media": {
              "markdown": "media/walkthrough/tasks.md"
            }
          },
          {
            "id": "conflicts",
            "title": "%walkthrough.conflicts.title%",
            "description": "%walkthrough.conflicts.description%",
            "media": {
              "markdown": "media/walkthrough/conflicts.md"
            }
          },
          {
            "id": "policy",
            "title": "%walkthrough.policy.title%",
            "description": "%walkthrough.policy.description%",
            "media": {
              "markdown": "media/walkthrough/policy.md"
            }
          },
          {
            "id": "review",
            "title": "%walkthrough.review.title%",
            "description": "%walkthrough.review.description%",
            "media": {
              "markdown": "media/walkthrough/review.md"
            }
          }
        ]
      }
    ],
    "themes": [
      {
        "label": "Synapse Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/synapse-dark-color-theme.json"
      }
    ],
    "colors": [
      {
        "id": "synapse.cardBackground",
        "description": "%color.cardBackground%",
        "defaults": {
          "dark": "#141417",
          "light": "#FFFFFF",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "synapse.cardBorder",
        "description": "%color.cardBorder%",
        "defaults": {
          "dark": "#26262B",
          "light": "#E4E4E7",
          "highContrast": "contrastBorder",
          "highContrastLight": "contrastBorder"
        }
      },
      {
        "id": "synapse.raisedBackground",
        "description": "%color.raisedBackground%",
        "defaults": {
          "dark": "#1C1C20",
          "light": "#F4F4F5",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "synapse.mutedForeground",
        "description": "%color.mutedForeground%",
        "defaults": {
          "dark": "#8B8B94",
          "light": "#5F5F69",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "synapse.subtleForeground",
        "description": "%color.subtleForeground%",
        "defaults": {
          "dark": "#80808A",
          "light": "#6B6B75",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "synapse.statusWorking",
        "description": "%color.statusWorking%",
        "defaults": {
          "dark": "#E4E4E7",
          "light": "#3F3F46",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "synapse.statusNeedsYou",
        "description": "%color.statusNeedsYou%",
        "defaults": {
          "dark": "#F2B84B",
          "light": "#9A5B00",
          "highContrast": "#FFD166",
          "highContrastLight": "#7A4700"
        }
      },
      {
        "id": "synapse.statusReview",
        "description": "%color.statusReview%",
        "defaults": {
          "dark": "#6EE7A0",
          "light": "#15803D",
          "highContrast": "#7CFFB2",
          "highContrastLight": "#0B5D2B"
        }
      },
      {
        "id": "synapse.statusError",
        "description": "%color.statusError%",
        "defaults": {
          "dark": "#F87171",
          "light": "#B91C1C",
          "highContrast": "#FF8080",
          "highContrastLight": "#8B0000"
        }
      },
      {
        "id": "synapse.statusIdle",
        "description": "%color.statusIdle%",
        "defaults": {
          "dark": "#A1A1AA",
          "light": "#5F5F69",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Synapse Dark",
      "workbench.activityBar.location": "hidden",
      "workbench.statusBar.visible": false,
      "workbench.layoutControl.enabled": false,
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.welcomePage.walkthroughs.openOnInstall": false,
      "workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
      "editor.minimap.enabled": false,
      "editor.fontFamily": "'JetBrains Mono', Menlo, Consolas, 'Droid Sans Mono', monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 20,
      "terminal.integrated.fontFamily": "'JetBrains Mono', Menlo, Consolas, monospace"
    },
    "keybindings": [
      {
        "command": "synapse.selectAgent",
        "args": 1,
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1"
      },
      {
        "command": "synapse.selectAgent",
        "args": 2,
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2"
      },
      {
        "command": "synapse.selectAgent",
        "args": 3,
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3"
      },
      {
        "command": "synapse.selectAgent",
        "args": 4,
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4"
      },
      {
        "command": "synapse.selectAgent",
        "args": 5,
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5"
      },
      {
        "command": "synapse.selectAgent",
        "args": 6,
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6"
      },
      {
        "command": "synapse.selectAgent",
        "args": 7,
        "key": "ctrl+alt+7",
        "mac": "cmd+alt+7"
      },
      {
        "command": "synapse.selectAgent",
        "args": 8,
        "key": "ctrl+alt+8",
        "mac": "cmd+alt+8"
      },
      {
        "command": "synapse.selectAgent",
        "args": 9,
        "key": "ctrl+alt+9",
        "mac": "cmd+alt+9"
      },
      {
        "command": "synapse.focusGuidance",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "synapse.nextAgent",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]"
      },
      {
        "command": "synapse.previousAgent",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+["
      },
      {
        "command": "synapse.openHome",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "package": "node esbuild.mjs && vsce package --no-dependencies",
    "test:smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@synapse/client": "0.1.0",
    "@synapse/core": "0.1.0",
    "@synapse/mock-agent": "0.1.0",
    "@types/vscode": "1.95.0",
    "esbuild": "0.25.12",
    "@vscode/test-electron": "2.5.2"
  },
  "l10n": "./l10n"
}
